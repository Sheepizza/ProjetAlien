mdl 1.3;

using state import *;

import adobe::mtl::*;
import adobe::util::*;
import ::tex::gamma_mode;
import ::state::normal;

export material stationary_003_Mat(*)
  = adobe::mtl::standard(
    translucence : float(0),
    interiorColor : color(1.0, 1.0, 1.0),
    indexOfRefraction : float(1.0000),
    metallic : adobe::util::float_texture( texture_2d("stationary_003/stationary_003_mat_metallic.png", ::tex::gamma_linear) ),
    baseColor : adobe::util::color_texture( texture_2d("stationary_003/stationary_003_mat_baseColor.png", ::tex::gamma_srgb) ),
    roughness : float(0.9104),
    density : float(0),
    glow : float(0.0),
    opacity : float(1.0),
    normal : ::state::normal(),
    height : float(0.5),
    heightScale : float(1.0)
    );
